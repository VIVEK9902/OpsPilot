# ==========================================
# OpsPilot Environment Configuration Example
# ==========================================

# Database Configuration
# The database URL for Spring Boot (Docker internal network example: jdbc:postgresql://db:5432/opspilot)
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_dev

# JWT Security
# Ensure this is a strong, random 256-bit+ secret in production.
# Example: openssl rand -base64 64
JWT_SECRET=this-is-a-default-secret-key-for-local-dev-only-do-not-use-in-prod

# Gemini Configuration
# Your Gemini API key for Phase 5 AI Assistant and Phase 4 PGVector Embeddings
GEMINI_API_KEY=your-gemini-api-key-here
